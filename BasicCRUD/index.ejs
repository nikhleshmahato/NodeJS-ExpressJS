<!DOCTYPE html>
<html>
<head>
  <title>Users</title>
</head>
<body>

<h1>User List</h1>

<a href="/create">Add New User</a>

<ul>
  <% users.forEach(user => { %>
    <li>
      <%= user.name %> - <%= user.age %>

      <a href="/edit/<%= user.id %>">Edit</a>

      <form action="/delete/<%= user.id %>" method="POST" style="display:inline;">
        <button type="submit">Delete</button>
      </form>
    </li>
  <% }) %>
</ul>

</body>
</html>